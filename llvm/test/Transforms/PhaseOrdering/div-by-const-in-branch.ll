; https://github.com/llvm/llvm-project/issues/214962
; int foo(int x, int y, bool k) { return k ? x / y : x / 7; }
; Keep the division by 7 separate, so it can still be strength-reduced.

define i32 @foo(i32 %x, i32 %y, i1 %k) {
; CHECK-LABEL: define i32 @foo(
; CHECK-SAME: i32 [[X:%.*]], i32 [[Y:%.*]], i1 [[K:%.*]]) local_unnamed_addr #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br i1 [[K]], label %[[T:.*]], label %[[F:.*]]
; CHECK:       [[T]]:
; CHECK-NEXT:    [[D1:%.*]] = sdiv i32 [[X]], [[Y]]
; CHECK-NEXT:    br label %[[END:.*]]
; CHECK:       [[F]]:
; CHECK-NEXT:    [[D2:%.*]] = sdiv i32 [[X]], 7
; CHECK-NEXT:    br label %[[END]]
; CHECK:       [[END]]:
; CHECK-NEXT:    [[R:%.*]] = phi i32 [ [[D1]], %[[T]] ], [ [[D2]], %[[F]] ]
; CHECK-NEXT:    ret i32 [[R]]
;
entry:
  br i1 %k, label %t, label %f
t:
  %d1 = sdiv i32 %x, %y
  br label %end
f:
  %d2 = sdiv i32 %x, 7
  br label %end
end:
  %r = phi i32 [ %d1, %t ], [ %d2, %f ]
  ret i32 %r
}
