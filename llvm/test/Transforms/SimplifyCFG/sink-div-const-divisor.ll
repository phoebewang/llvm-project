; Don't sink a div/rem into the common successor when that would turn a
; constant divisor into a variable one.

declare void @use(i32)

define i32 @sdiv_const_divisor(i32 %x, i32 %y, i1 %k) {
; CHECK-LABEL: define i32 @sdiv_const_divisor(
; CHECK-SAME: i32 [[X:%.*]], i32 [[Y:%.*]], i1 [[K:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    br i1 [[K]], label %[[T:.*]], label %[[F:.*]]
; CHECK:       [[T]]:
; CHECK-NEXT:    call void @use(i32 0)
; CHECK-NEXT:    [[D1:%.*]] = sdiv i32 [[X]], [[Y]]
; CHECK-NEXT:    br label %[[END:.*]]
; CHECK:       [[F]]:
; CHECK-NEXT:    call void @use(i32 1)
; CHECK-NEXT:    [[D2:%.*]] = sdiv i32 [[X]], 7
; CHECK-NEXT:    br label %[[END]]
; CHECK:       [[END]]:
; CHECK-NEXT:    [[R:%.*]] = phi i32 [ [[D1]], %[[T]] ], [ [[D2]], %[[F]] ]
; CHECK-NEXT:    ret i32 [[R]]
;
entry:
  br i1 %k, label %t, label %f
t:
  call void @use(i32 0)
  %d1 = sdiv i32 %x, %y
  br label %end
f:
  call void @use(i32 1)
  %d2 = sdiv i32 %x, 7
  br label %end
end:
  %r = phi i32 [ %d1, %t ], [ %d2, %f ]
  ret i32 %r
}

